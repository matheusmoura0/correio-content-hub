<div style="display:flex;justify-content:space-between;align-items:center">
  <h1>Categorias</h1>
  <%= link_to "Nova categoria", new_category_path, class: "button" %>
</div>
<table>
  <thead><tr><th>Site</th><th>Nome</th><th>Slug</th><th></th></tr></thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <td><%= category.site.name %></td>
        <td><%= category.name %></td>
        <td><%= category.slug %></td>
        <td><%= link_to "Editar", edit_category_path(category) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
