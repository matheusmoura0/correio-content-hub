<div class="page-heading">
  <div><h1>Categorias</h1><p class="muted">Organização editorial dos sites cadastrados.</p></div>
  <%= link_to "Nova categoria", new_category_path, class: "button" %>
</div>
<table>
  <thead><tr><th>Site</th><th>Nome</th><th>Slug</th><th></th></tr></thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <td data-label="Site"><%= category.site.name %></td>
        <td data-label="Nome"><%= category.name %></td>
        <td data-label="Identificador"><%= category.slug %></td>
        <td data-label="Ações"><%= link_to "Editar", edit_category_path(category) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
