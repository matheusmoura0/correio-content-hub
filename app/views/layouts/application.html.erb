<!DOCTYPE html>
<html>
  <head>
    <title>Correio Content Hub</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      :root { --ink:#172124; --paper:#f4f1ea; --white:#fff; --accent:#d85532; --line:#ddd9d0; --muted:#687174; }
      * { box-sizing: border-box; }
      body { font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif; margin: 0; background: var(--paper); color: var(--ink); line-height: 1.5; }
      header { background: var(--ink); color: white; padding: 14px 24px; display: flex; gap: 22px; align-items: center; flex-wrap: wrap; }
      header strong { margin-right: 12px; font-family: Georgia, serif; font-size: 19px; }
      header a { color: white; text-decoration: none; }
      header form { margin-left: auto; }
      header button { background: transparent !important; border: 1px solid #667074 !important; }
      main { max-width: 1160px; margin: 36px auto; padding: 0 22px; }
      h1, h2 { font-family: Georgia, serif; line-height: 1.14; margin-top: 0; }
      h1 { font-size: clamp(30px, 4vw, 46px); margin-bottom: 8px; }
      .card { background: white; border: 1px solid var(--line); border-radius: 12px; padding: 22px; margin-bottom: 18px; box-shadow: 0 5px 18px rgba(23,33,36,.035); }
      .grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(180px,1fr)); gap: 16px; }
      table { width: 100%; border-collapse: collapse; background: white; }
      th, td { padding: 12px; border-bottom: 1px solid #e5e5e5; text-align: left; vertical-align: top; }
      td small { display:block; color:var(--muted); margin-top:4px; }
      input, select, textarea { width: 100%; box-sizing: border-box; padding: 11px 12px; margin: 6px 0 14px; border:1px solid #c8cbc8; border-radius:6px; font:inherit; background:white; }
      input[type=checkbox] { width: auto; }
      .button, button, input[type=submit] { display: inline-block; width: auto; background: var(--ink); color: white; border: 0; border-radius: 6px; padding: 10px 14px; text-decoration: none; cursor: pointer; font:inherit; font-weight:650; }
      .accent { background:var(--accent) !important; }
      .secondary { background:#e7e6e1; color:var(--ink); }
      .danger { background:#9f2c2c; }
      .muted { color: var(--muted); }
      .notice { background: #e8f5e9; padding: 10px; margin-bottom: 16px; }
      .alert { background: #ffebee; padding: 10px; margin-bottom: 16px; }
      .page-heading { display:flex; justify-content:space-between; align-items:flex-start; gap:20px; margin-bottom:24px; }
      .page-heading.compact { margin-bottom:12px; }
      .actions { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
      .actions form { margin:0; }
      .eyebrow { text-transform:uppercase; letter-spacing:.12em; font-size:12px; font-weight:800; color:var(--accent); margin:0 0 6px; }
      .badge { display:inline-block; background:#eceae4; border-radius:999px; padding:4px 9px; font-size:12px; white-space:nowrap; }
      .stat strong { display:block; font:700 38px Georgia,serif; }
      .stat span { color:var(--muted); }
      .callout { display:flex; align-items:center; justify-content:space-between; gap:24px; margin-top:20px; background:#fff8ef; border-color:#ead7c3; }
      .callout h2, .callout p { margin-bottom:5px; }
      .result-row { display:flex; justify-content:space-between; gap:16px; padding:13px 0; border-top:1px solid #eceae5; }
      .result-row small { display:block; color:var(--muted); }
      .metric { margin:8px 0 16px; }
      .search-bar { display:flex; gap:8px; margin-bottom:18px; }
      .search-bar input { margin:0; }
      .search-bar input[type=search] { flex:1; }
      .check { display:block; margin-bottom:18px; }
      .empty-state { text-align:center; padding:56px 20px; border:1px dashed #bbb; border-radius:12px; }
      .article-copy { max-width:780px; font-family:Georgia,serif; font-size:18px; }
      .rewrite-panel { border-left:4px solid var(--accent); }
      .link-danger { background:transparent; color:#9f2c2c; padding:0; }
      @media (max-width: 760px) { header { gap:14px; } header strong { width:100%; } header form { margin-left:0; } main { margin-top:24px; } .page-heading,.callout { flex-direction:column; } table { display:block; overflow-x:auto; } .actions { align-items:flex-start; } }
    </style>
  </head>
  <body>
    <header>
      <strong><%= link_to "Correio Content Hub", root_path %></strong>
      <% if user_signed_in? %>
        <% if current_user.admin? %>
          <%= link_to "Sites", sites_path %>
          <%= link_to "Categorias", categories_path %>
          <%= link_to "Feeds", feeds_path %>
        <% end %>
        <%= link_to "Pescar matérias", topics_path %>
        <%= link_to "Matérias", articles_path %>
        <%= link_to "Usuários", users_path if current_user.admin? %>
        <%= button_to "Sair", destroy_user_session_path, method: :delete %>
      <% end %>
    </header>
    <main>
      <% if notice.present? %><div class="notice"><%= notice %></div><% end %>
      <% if alert.present? %><div class="alert"><%= alert %></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>
