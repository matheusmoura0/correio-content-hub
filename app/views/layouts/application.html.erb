<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title>Content Hub | Correio da Manhã</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      :root { --cm-red:#b00016; --cm-red-dark:#82000f; --ink:#151515; --paper:#f7f7f5; --white:#fff; --line:#e2e2de; --muted:#6b6b68; --success:#176b3a; }
      * { box-sizing:border-box; }
      body { margin:0; background:var(--paper); color:var(--ink); font-family:Arial, Helvetica, sans-serif; line-height:1.5; }
      a { color:var(--cm-red); text-decoration:none; }
      a:hover { text-decoration:underline; }
      .site-header { background:var(--white); border-top:6px solid var(--cm-red); box-shadow:0 1px 0 rgba(0,0,0,.08); }
      .masthead { border-bottom:1px solid var(--line); }
      .header-inner { width:min(1240px, calc(100% - 40px)); margin:0 auto; display:flex; align-items:center; justify-content:space-between; gap:24px; }
      .masthead .header-inner { min-height:86px; }
      .brand { display:flex; align-items:center; color:var(--ink); text-decoration:none; }
      .brand:hover { text-decoration:none; }
      .brand-mark { display:inline-flex; align-items:center; justify-content:center; width:66px; height:54px; margin-right:14px; background:var(--cm-red); color:#fff; font:800 30px Georgia, serif; letter-spacing:-2px; }
      .brand-name { display:block; font:700 26px/1 Georgia, "Times New Roman", serif; }
      .brand-product { display:block; margin-top:5px; color:var(--cm-red); font-size:11px; font-weight:800; letter-spacing:.16em; text-transform:uppercase; }
      .session { display:flex; align-items:center; gap:14px; color:var(--muted); font-size:13px; }
      .session form { margin:0; }
      .logout { padding:8px 12px !important; border:1px solid #bbb !important; background:#fff !important; color:#222 !important; }
      .main-nav { background:#fff; border-bottom:1px solid var(--line); }
      .main-nav .header-inner { min-height:46px; justify-content:flex-start; overflow-x:auto; }
      .nav-link { display:flex; align-items:center; min-height:48px; padding:0 15px; color:#292929; font-size:14px; font-weight:700; white-space:nowrap; border-bottom:3px solid transparent; }
      .nav-link:hover { color:var(--cm-red); background:#fafafa; text-decoration:none; }
      .nav-link.active { color:var(--cm-red); border-bottom-color:var(--cm-red); }
      main { max-width:1240px; margin:44px auto 80px; padding:0 28px; }
      h1, h2, h3 { font-family:Georgia, "Times New Roman", serif; line-height:1.12; }
      h1 { margin:0 0 8px; font-size:clamp(32px,4vw,48px); letter-spacing:-.02em; }
      h2 { margin-top:0; }
      .page-heading { position:relative; display:flex; justify-content:space-between; align-items:flex-start; gap:28px; padding-bottom:22px; margin-bottom:30px; border-bottom:1px solid var(--line); }
      .page-heading::after { content:""; position:absolute; left:0; bottom:-1px; width:86px; height:4px; background:var(--cm-red); }
      .page-heading.compact { padding-bottom:15px; margin-bottom:16px; }
      .page-heading.compact::after { width:54px; height:3px; }
      .card { margin-bottom:22px; padding:26px; background:#fff; border:0; border-radius:5px; box-shadow:0 4px 18px rgba(20,20,20,.055); }
      .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:18px; }
      table { width:100%; border-collapse:collapse; background:#fff; border-top:3px solid var(--cm-red); box-shadow:0 4px 18px rgba(20,20,20,.05); }
      th { background:#efefec; color:#333; font-size:12px; letter-spacing:.06em; text-transform:uppercase; }
      th, td { padding:13px 14px; border-bottom:1px solid #e5e5e2; text-align:left; vertical-align:top; }
      tbody tr:hover { background:#faf9f7; }
      td small { display:block; margin-top:4px; color:var(--muted); }\n      td small.image-ok { color:var(--success); font-weight:700; }\n      td small.image-pending { color:#9a6c00; font-weight:700; }
      label { display:block; margin-bottom:2px; font-size:13px; font-weight:700; }
      input, select, textarea { width:100%; margin:6px 0 16px; padding:11px 12px; border:1px solid #bbb; border-radius:2px; background:#fff; color:#111; font:inherit; }
      input:focus, select:focus, textarea:focus { outline:2px solid rgba(176,0,22,.2); border-color:var(--cm-red); }
      input[type=checkbox] { width:auto; margin-right:6px; }
      .button, button, input[type=submit] { display:inline-block; width:auto; padding:10px 15px; border:0; border-radius:2px; background:var(--cm-red); color:#fff; cursor:pointer; font:700 14px Arial, sans-serif; text-decoration:none; }
      .button:hover, button:hover, input[type=submit]:hover { background:var(--cm-red-dark); text-decoration:none; }
      .accent { background:var(--cm-red) !important; }
      .secondary { background:#e4e4e1; color:#111; }
      .secondary:hover { background:#d4d4d0; }
      .danger { background:#333; }
      .muted { color:var(--muted); }
      .notice, .alert { margin-bottom:18px; padding:12px 15px; border-left:4px solid; background:#fff; }
      .notice { border-color:var(--success); color:#13572f; }
      .alert { border-color:var(--cm-red); color:#7a0010; }
      .actions { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
      .actions form { margin:0; }
      .eyebrow { margin:0 0 7px; color:var(--cm-red); font-size:11px; font-weight:800; letter-spacing:.16em; text-transform:uppercase; }
      .badge { display:inline-block; padding:4px 9px; border-radius:2px; background:#e7e7e4; color:#333; font-size:11px; font-weight:700; text-transform:uppercase; white-space:nowrap; }
      .status-imported { background:#e8edf3; color:#294e73; }
      .status-reviewing { background:#fff1c9; color:#795700; }
      .status-approved { background:#dff2e5; color:#176438; }
      .status-published { background:var(--cm-red); color:#fff; }
      .status-ignored { background:#e4e4e4; color:#555; }
      .stat { position:relative; overflow:hidden; border-left:4px solid var(--cm-red); }
      .stat strong { display:block; color:var(--cm-red); font:700 40px Georgia,serif; }
      .stat span { color:#444; font-size:13px; font-weight:700; text-transform:uppercase; }
      .callout { display:flex; align-items:center; justify-content:space-between; gap:32px; margin:28px 0 36px; padding:32px; background:linear-gradient(120deg,#181818,#2b2b2b); color:#fff; }
      .callout h2, .callout p { margin-bottom:5px; }
      .result-row { display:flex; justify-content:space-between; gap:16px; padding:14px 0; border-top:1px solid #e4e4e1; }
      .result-row small { display:block; color:var(--muted); }
      .metric { margin:8px 0 16px; }
      .search-bar { display:flex; gap:8px; margin-bottom:18px; }
      .search-bar input { margin:0; }
      .search-bar input[type=search] { flex:1; }
      .filter-links { display:flex; gap:12px; flex-wrap:wrap; font-size:13px; font-weight:700; }
      .check { display:block; margin-bottom:18px; }
      .empty-state { padding:56px 20px; border-top:4px solid var(--cm-red); background:#fff; text-align:center; }
      .article-copy { max-width:780px; font:18px/1.7 Georgia,serif; }
      .article-copy img { max-width:100%; }
      .rewrite-panel { border-left:5px solid var(--cm-red); }
      .publication-tabs { margin-bottom:18px; padding:12px 15px; background:#fff; border-left:4px solid var(--cm-red); }\n      .bulk-toolbar { display:flex; align-items:center; justify-content:space-between; gap:16px; margin:0 0 12px; padding:13px 15px; background:#fff; border-left:4px solid #333; }\n      .bulk-toolbar label { margin:0; }\n      .bulk-toolbar input { margin:0 7px 0 0; }\n      .bulk-toolbar button:disabled { cursor:not-allowed; opacity:.45; }\n      .selection-cell { width:88px; text-align:center; }\n      .selection-cell input { width:auto; margin:0; }
      .publication-stats { margin-bottom:22px; }
      .publication-panel { border-top:5px solid var(--cm-red); }
      .publication-help { margin-top:-4px; }
      .distribution-card { margin:16px 0; padding:18px; border:1px solid var(--line); background:#fafaf8; }
      .distribution-card.selected { border-color:#c8a3a8; background:#fffafa; }
      .distribution-toggle { display:flex; align-items:flex-start; gap:8px; font-size:16px; }
      .distribution-toggle input { margin-top:5px; }
      .distribution-toggle span,.distribution-toggle small { display:block; }
      .distribution-toggle small { color:var(--muted); font-weight:400; }
      .distribution-fields { display:grid; grid-template-columns:1.2fr 1.2fr .5fr; gap:14px; margin:16px 0 0 28px; }
      .distribution-fields input,.distribution-fields select { margin-bottom:4px; }
      .publication-state { display:flex; align-items:center; gap:8px; margin:8px 0 0 28px; color:var(--muted); font-size:12px; }

      .source-image-reference { position:relative; max-width:420px; margin:18px 0; }
      .source-image-reference img { width:100%; max-height:260px; object-fit:cover; filter:saturate(.55); }
      .source-image-reference span { display:block; padding:9px 11px; background:#2a2a2a; color:#fff; font-size:11px; }
      .image-rights-panel { border-top:5px solid #c98900; }
      .licensed-image-sources { display:flex; gap:8px; flex-wrap:wrap; margin:18px 0 22px; }
      .image-rights-grid { display:grid; grid-template-columns:1fr 1fr; gap:0 14px; }
      .image-rights-grid .wide { grid-column:1 / -1; }
      .licensed-image-preview { display:grid; grid-template-columns:160px 1fr; gap:14px; align-items:center; margin:5px 0 18px; padding:12px; background:#f2f2ee; }
      .licensed-image-preview img { width:160px; height:100px; object-fit:cover; }
      .licensed-image-preview span { color:var(--muted); font-size:12px; }
      .rights-confirmation { display:flex; align-items:flex-start; gap:10px; margin:16px 0; padding:15px; background:#eef7f0; border-left:4px solid var(--success); }
      .rights-confirmation input { width:auto; margin:4px 0 0; }
      .rights-confirmation span { font-weight:600; }
      .rights-audit { color:var(--muted); font-size:12px; }
      .publication-requirement { padding:22px; background:#fff3d7; border-left:4px solid #d39b00; }
      .publication-requirement strong,.publication-requirement p { display:block; margin:0; }
      .publication-requirement p { margin-top:5px; color:#6d570d; }
      .publication-preview { display:grid; grid-template-columns:150px 1fr; gap:18px; align-items:center; margin-bottom:22px; padding:14px; background:#f5f3ee; }
      .publication-preview img { width:150px; height:100px; object-fit:cover; }\n      .publication-preview.without-image { grid-template-columns:1fr; }
      .publication-preview span,.publication-preview strong { display:block; }
      .publication-preview span { margin-bottom:5px; color:var(--cm-red); font-size:11px; font-weight:800; text-transform:uppercase; }
      .publication-preview strong { font:700 22px/1.2 Georgia,serif; }
      .gastronomy-publish-form { display:grid; grid-template-columns:1.2fr 1.2fr .5fr auto; gap:12px; align-items:end; }
      .gastronomy-publish-form input,.gastronomy-publish-form select { margin:5px 0 0; }
      .gastronomy-publish-form input[type=submit] { min-height:44px; }

      .visual-publication-editor { margin-top:22px; }
      .editor-workspace { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(340px,.75fr); gap:24px; align-items:start; }
      .cover-map-panel,.publication-customizer { min-width:0; padding:20px; border:1px solid var(--line); background:#fafaf7; }
      .publication-customizer { position:sticky; top:18px; background:#fff; }
      .editor-section-heading { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; margin-bottom:16px; }
      .editor-section-heading > div { display:flex; align-items:flex-start; gap:10px; }
      .editor-section-heading span { display:flex; align-items:center; justify-content:center; width:26px; height:26px; flex:none; border-radius:50%; background:var(--cm-red); color:#fff; font-weight:800; }
      .editor-section-heading strong,.editor-section-heading small { display:block; }
      .editor-section-heading small { margin-top:2px; color:var(--muted); font-weight:400; }
      .gastronomy-cover-map { overflow:hidden; border:1px solid #d8d0c4; background:#fdfaf5; box-shadow:0 12px 26px rgba(40,25,12,.1); }
      .mock-masthead { padding:17px; border-top:7px solid #7c1d2b; color:#7c1d2b; text-align:center; font:12px Georgia,serif; letter-spacing:.22em; }
      .mock-masthead b { display:block; margin-top:3px; font-size:25px; letter-spacing:-.04em; }
      .mock-breaking { display:grid; grid-template-columns:auto repeat(3,1fr); align-items:stretch; border-block:1px solid #e2d8ca; }
      .mock-breaking > span { padding:8px; background:#ef5a38; color:#fff; font-size:9px; font-weight:800; }
      .mock-breaking button,.mock-popular button { margin:0; padding:8px; border-radius:0; border-left:1px solid #e2d8ca; background:transparent; color:#302a25; font-size:9px; font-weight:700; }
      .mock-breaking button:hover,.mock-popular button:hover { background:#fff0e9; color:#7c1d2b; }
      .mock-cover-body { display:grid; grid-template-columns:minmax(0,1.75fr) minmax(150px,.75fr); gap:12px; padding:14px; }
      .mock-slot { position:relative; display:flex; flex-direction:column; justify-content:flex-end; width:100%; min-height:105px; margin:0; padding:12px; overflow:hidden; border:2px solid transparent; border-radius:2px; background:linear-gradient(145deg,#857367,#3c3029); color:#fff; text-align:left; transition:.15s ease; }
      .mock-slot:hover { border-color:#ef5a38; transform:translateY(-1px); }
      .mock-slot span { font-size:8px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
      .mock-slot strong { margin-top:3px; font:700 14px/1.12 Georgia,serif; }
      .mock-hero { min-height:220px; background:linear-gradient(145deg,#71825a,#293a25); }
      .mock-hero strong { max-width:80%; font-size:24px; }
      .mock-fresh-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:8px; margin-top:8px; }
      .mock-fresh-grid .mock-slot { min-height:88px; background:linear-gradient(145deg,#b49372,#624b38); }
      .mock-cover-body aside { display:flex; flex-direction:column; gap:10px; }
      .mock-editor-pick { min-height:150px; background:linear-gradient(145deg,#9b584c,#4d2722); }
      .mock-popular { padding:10px; border-top:3px solid #7c1d2b; background:#fff; }
      .mock-popular > b { display:block; margin-bottom:6px; color:#7c1d2b; font:11px Georgia,serif; }
      .mock-popular button { display:block; width:100%; border-left:0; border-top:1px solid #eee6dd; text-align:left; }
      .mock-popular em { color:#ef5a38; font:700 15px Georgia,serif; }
      .gastronomy-cover-map [data-slot].selected { z-index:1; outline:3px solid #ef5a38; outline-offset:-3px; background-color:#7c1d2b; box-shadow:inset 0 0 0 2px #fff; }

      .publication-destination-tabs { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:12px; padding:5px; border-radius:4px; background:#e9e6df; }
      .destination-tab { margin:0; background:transparent; color:#514b44; }
      .destination-tab:hover { background:#f5f1ea; color:#7c1d2b; }
      .destination-tab.active { background:#7c1d2b; color:#fff; box-shadow:0 3px 10px rgba(60,20,22,.18); }
      .mock-category-nav { padding:8px 12px; border-block:1px solid #e2d8ca; color:#655b52; font-size:8px; font-weight:800; text-align:center; word-spacing:8px; }
      .mock-category-title { position:relative; padding:20px 14px 13px; border-bottom:1px solid #e2d8ca; }
      .mock-category-title::after { content:""; position:absolute; left:14px; bottom:-2px; width:48px; height:4px; background:#ef5a38; }
      .mock-category-title span,.mock-category-title strong { display:block; }
      .mock-category-title span { color:#ef5a38; font-size:8px; font-weight:800; letter-spacing:.14em; }
      .mock-category-title strong { color:#7c1d2b; font:700 27px Georgia,serif; text-transform:capitalize; }
      .mock-category-leads { display:grid; grid-template-columns:minmax(0,1.6fr) minmax(140px,.8fr); gap:8px; padding:14px; }
      .mock-category-leads > div { display:grid; gap:8px; }
      .mock-category-hero { min-height:230px; background:linear-gradient(145deg,#71825a,#293a25); }
      .mock-category-leads > div .mock-slot { min-height:111px; background:linear-gradient(145deg,#9b584c,#4d2722); }
      .mock-category-list { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; padding:0 14px 14px; }
      .mock-category-list > b { grid-column:1/-1; padding-block:9px 5px; border-top:3px solid #7c1d2b; color:#7c1d2b; font:11px Georgia,serif; }
      .mock-category-list button { display:grid; grid-template-columns:42px 1fr; gap:8px; align-items:center; min-height:54px; margin:0; padding:7px; border:1px solid #e2d8ca; border-radius:0; background:#fff; color:#302a25; text-align:left; }
      .mock-category-list button i { width:42px; height:38px; background:linear-gradient(145deg,#b49372,#624b38); }
      .mock-category-list button span { font:700 10px/1.2 Georgia,serif; }
      .mock-category-list button:hover { border-color:#ef5a38; background:#fff8f4; }

      .selected-slot-summary { display:flex; align-items:center; gap:10px; margin-top:12px; padding:12px; background:#fff; border:1px solid var(--line); }
      .selection-dot { width:11px; height:11px; border-radius:50%; background:#ef5a38; box-shadow:0 0 0 4px #ffe5dc; }
      .selected-slot-summary small,.selected-slot-summary strong { display:block; }
      .selected-slot-summary small { color:var(--muted); font-size:9px; letter-spacing:.1em; }
      .accessible-slot-select { margin-top:12px; }
      .accessible-slot-select select { margin-bottom:0; }
      .live-card-preview { overflow:hidden; margin-bottom:20px; border:1px solid #d8d0c4; background:#fdfaf5; }
      .live-image-frame { height:230px; overflow:hidden; background:#ddd; }
      .live-image-frame img { width:100%; height:100%; object-fit:cover; transition:transform .18s ease,object-position .18s ease; }
      .live-preview-copy { padding:17px; }
      .live-preview-copy span,.live-preview-copy strong,.live-preview-copy small { display:block; }
      .live-preview-copy span { color:#ef5a38; font-size:9px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
      .live-preview-copy strong { margin:5px 0 8px; font:700 25px/1.08 Georgia,serif; overflow-wrap:anywhere; }
      .live-preview-copy small { color:var(--muted); }
      .control-label { display:flex; align-items:center; justify-content:space-between; gap:12px; }
      .control-label label { margin:0; }
      .text-action { padding:4px 0; background:transparent; color:var(--cm-red); font-size:11px; }
      .text-action:hover { background:transparent; text-decoration:underline; }
      .title-control textarea { resize:vertical; }
      .title-control > small { display:block; margin:-11px 0 18px; color:var(--muted); }
      .image-composer { margin:4px 0 18px; padding:14px; border:1px solid var(--line); background:#fafaf8; }
      .crop-actions { display:flex; gap:6px; flex-wrap:wrap; margin-top:10px; }
      .crop-actions button { padding:7px 10px; }
      .range-control { display:grid; grid-template-columns:auto 1fr auto; gap:10px; align-items:center; margin-top:10px; }
      .range-control input { margin:0; }
      .range-control output { min-width:40px; font-size:12px; font-weight:700; }
      .image-empty-note { margin-bottom:18px; padding:13px; border-left:4px solid #aaa; background:#f2f2ef; color:var(--muted); }
      .publish-visual-button { width:100% !important; min-height:48px; margin-top:4px; }

      .unpublish-row { display:flex; justify-content:space-between; align-items:center; gap:16px; margin-top:20px; padding-top:18px; border-top:1px solid var(--line); color:var(--muted); font-size:12px; }
      .unpublish-row form { margin:0; }

      .link-danger { padding:0; background:transparent; color:var(--cm-red); }
      .auth-card { max-width:520px; margin:70px auto; border-top:5px solid var(--cm-red); }
      .auth-card input[type=submit] { width:100%; }
      .topic { padding:30px; }
      .topic .metric { display:inline-flex; align-items:center; gap:5px; padding:8px 11px; background:#f4f4f1; border-radius:3px; }
      .button[disabled], button[disabled], input[type=submit][disabled] { cursor:wait; opacity:.72; }
      .is-loading { position:relative; padding-left:38px !important; }
      .is-loading::before { content:""; position:absolute; left:14px; top:50%; width:14px; height:14px; margin-top:-8px; border:2px solid rgba(255,255,255,.4); border-top-color:#fff; border-radius:50%; animation:spin .75s linear infinite; }
      .loading-indicator { position:fixed; right:24px; bottom:24px; z-index:1000; display:flex; align-items:center; gap:13px; max-width:360px; padding:15px 18px; background:#171717; color:#fff; border-left:5px solid var(--cm-red); border-radius:3px; box-shadow:0 12px 32px rgba(0,0,0,.25); opacity:0; pointer-events:none; transform:translateY(18px); transition:.2s ease; }
      .loading-indicator.visible { opacity:1; transform:translateY(0); }
      .loading-spinner { width:20px; height:20px; flex:none; border:3px solid #555; border-top-color:#fff; border-radius:50%; animation:spin .8s linear infinite; }
      .loading-copy strong, .loading-copy span { display:block; }
      .loading-copy span { margin-top:2px; color:#bbb; font-size:12px; }
      .turbo-progress-bar { height:4px; background:var(--cm-red); }
      .presence { display:inline-flex; align-items:center; gap:7px; }
      .presence-dot { display:inline-block; width:9px; height:9px; flex:none; border-radius:50%; background:#aaa; box-shadow:0 0 0 3px rgba(0,0,0,.05); }
      .presence-dot.online { background:#20b15a; box-shadow:0 0 0 3px rgba(32,177,90,.14); }
      .presence-dot.offline { background:#aaa; }
      .dashboard-columns { display:grid; grid-template-columns:minmax(0,1.65fr) minmax(280px,.75fr); gap:34px; align-items:start; }
      .section-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; padding-bottom:11px; margin-bottom:0; border-bottom:3px solid var(--cm-red); }
      .section-heading h2 { margin:0; font-size:23px; }
      .section-heading a { font-size:12px; font-weight:700; }
      .news-list, .online-list, .mini-activity, .activity-list { background:#fff; }
      .news-list article { padding:18px 20px; border-bottom:1px solid var(--line); }
      .news-list article strong { font:700 18px/1.3 Georgia,serif; }
      .news-list article .muted { margin-top:5px; font-size:12px; }
      .online-count { display:inline-flex; align-items:center; justify-content:center; min-width:25px; height:25px; border-radius:50%; background:#e3f6e9; color:#176b3a; font-size:12px; font-weight:800; }
      .online-list > div { display:grid; grid-template-columns:auto 1fr; gap:0 10px; align-items:center; padding:14px 16px; border-bottom:1px solid var(--line); }
      .online-list small { grid-column:2; color:var(--muted); }
      .activity-title { margin-top:30px; }
      .mini-activity > div { padding:13px 16px; border-bottom:1px solid var(--line); }
      .mini-activity strong, .mini-activity span, .mini-activity small { display:block; }
      .mini-activity span { margin:2px 0; font-size:13px; }
      .mini-activity small, .activity-item time { color:var(--muted); font-size:11px; }
      .activity-filter { margin-bottom:24px; padding:18px; background:#fff; }
      .activity-filter > div { display:flex; gap:8px; }
      .activity-filter select { flex:1; margin:5px 0 0; }
      .activity-filter input { margin:5px 0 0; }
      .activity-list { box-shadow:0 4px 18px rgba(20,20,20,.05); }
      .activity-item { display:grid; grid-template-columns:42px 1fr; gap:14px; padding:18px 20px; border-bottom:1px solid var(--line); }
      .activity-avatar { display:flex; align-items:center; justify-content:center; width:42px; height:42px; border-radius:50%; background:var(--cm-red); color:#fff; font:700 18px Georgia,serif; }
      .activity-item p { margin:2px 0; }
      @keyframes spin { to { transform:rotate(360deg); } }

      .publication-command-bar { margin-bottom:22px; padding:18px 20px; background:#171717; color:#fff; border-left:6px solid var(--cm-red); }
      .populate-form { display:grid; grid-template-columns:1fr 1fr auto; gap:14px; align-items:end; }
      .populate-form label { color:#ddd; }
      .populate-form select { margin:5px 0 0; }
      .populate-form input[type=submit] { min-height:44px; }
      .publication-console-grid { display:grid; grid-template-columns:minmax(0,1fr) 330px; gap:22px; align-items:start; margin-bottom:28px; }
      .site-mock-panel,.manual-placement-panel { min-width:0; background:#fff; box-shadow:0 4px 18px rgba(20,20,20,.06); }
      .site-mock-panel { padding:18px; }
      .manual-placement-panel { position:sticky; top:18px; padding:22px; border-top:5px solid var(--cm-red); }
      .mock-toolbar { display:flex; justify-content:space-between; align-items:center; gap:16px; margin-bottom:14px; color:var(--muted); font-size:12px; }
      .mock-toolbar > div { display:flex; align-items:center; gap:8px; color:var(--ink); }
      .site-layout-mock { overflow:hidden; border:1px solid #d7d7d2; }
      .visual-slot,.cinema-ticker button,.journal-front-mock aside button { width:100%; min-width:0; margin:0; border:0; border-radius:0; text-align:left; overflow:hidden; }
      .visual-slot.selected,.cinema-ticker button.selected,.journal-front-mock aside button.selected { outline:4px solid #ed3656; outline-offset:-4px; }
      .visual-slot small,.visual-slot strong,.visual-slot em { display:block; }
      .visual-slot em { margin-top:8px; font-size:10px; font-style:normal; opacity:.75; }
      .cinemagazine-mock { background:#0c0c10; color:#fff; }
      .cinemagazine-mock > header { padding:17px 20px; border-bottom:1px solid #303038; }
      .cinemagazine-mock > header b { font-size:24px; font-style:italic; letter-spacing:-.07em; }
      .cinemagazine-mock > header b span { color:#d6ff34; }
      .cinemagazine-mock > header nav { float:right; padding-top:8px; color:#aaa; font-size:8px; word-spacing:7px; }
      .cinema-lead { min-height:270px; padding:28px; background:linear-gradient(110deg,rgba(0,0,0,.88),rgba(0,0,0,.18)),linear-gradient(145deg,#8b3158,#142b45); color:#fff; }
      .cinema-lead small { color:#d6ff34; letter-spacing:.12em; }
      .cinema-lead strong { max-width:70%; margin-top:7px; font:800 32px/1 Arial,sans-serif; }
      .cinema-ticker { display:grid; grid-template-columns:auto repeat(3,1fr); border-block:1px solid #303038; }
      .cinema-ticker b { padding:10px 13px; background:#d6ff34; color:#111; font-size:9px; }
      .cinema-ticker button { padding:10px 12px; background:#15151b; color:#eee; border-left:1px solid #303038; font-size:9px; }
      .external-catalog-preview { padding:18px; background:#111117; }
      .external-catalog-preview > span { float:right; color:#d6ff34; font-size:9px; }
      .external-catalog-preview > b { font-size:13px; }
      .external-catalog-preview > div { display:grid; grid-template-columns:repeat(5,1fr); gap:8px; margin:10px 0 6px; }
      .external-catalog-preview i { aspect-ratio:2/3; background:linear-gradient(145deg,#48485b,#1f1f29); }
      .external-catalog-preview small { color:#777; }
      .cinema-news-mock { padding:18px; }
      .cinema-news-mock h3 { color:#d6ff34; font:800 13px Arial,sans-serif; }
      .cinema-news-mock > div { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
      .cinema-news-mock .visual-slot { min-height:150px; padding:0 12px 12px; background:#1a1a21; color:#fff; }
      .cinema-news-mock .visual-slot i { display:block; height:82px; margin:0 -12px 10px; background:linear-gradient(145deg,#78405b,#293044); }
      .cinema-news-mock .visual-slot small { color:#d6ff34; font-size:8px; }
      .cinema-news-mock .visual-slot strong { margin-top:4px; font-size:11px; }
      .cinema-journal-mock { padding:20px; background:#f5f0e7; color:#211e1a; font-family:Georgia,serif; }
      .cinema-journal-mock > header { padding-bottom:15px; border-bottom:4px double #241f1b; text-align:center; }
      .cinema-journal-mock > header small,.cinema-journal-mock > header b { display:block; }
      .cinema-journal-mock > header small { letter-spacing:.35em; }
      .cinema-journal-mock > header b { font-size:37px; line-height:1; }
      .cinema-journal-mock > header nav { margin-top:12px; font:8px Arial,sans-serif; word-spacing:10px; }
      .journal-front-mock { display:grid; grid-template-columns:1.5fr 1fr .75fr; gap:12px; padding:18px 0; border-bottom:1px solid #aaa294; }
      .journal-front-mock .visual-slot { padding:12px; background:#e6dfd3; color:#211e1a; }
      .journal-lead { min-height:265px; background:linear-gradient(0deg,rgba(20,16,12,.84),rgba(20,16,12,.05)),#817467 !important; color:#fff !important; }
      .journal-lead strong { margin-top:auto; font-size:25px; }
      .journal-secondary { display:grid; gap:10px; }
      .journal-secondary .visual-slot { min-height:127px; }
      .journal-secondary i,.journal-section-mock i { display:block; height:55px; margin:-12px -12px 9px; background:#aa9d8c; }
      .journal-front-mock aside { border-left:1px solid #aaa294; padding-left:10px; }
      .journal-front-mock aside b { font-size:11px; }
      .journal-front-mock aside button { padding:10px 0; background:transparent; color:#312d27; border-top:1px solid #c9c1b4; font:10px/1.25 Georgia,serif; }
      .journal-section-mock { padding-top:16px; }
      .journal-section-mock h3 { padding-bottom:6px; border-bottom:2px solid #241f1b; font-size:14px; }
      .journal-section-mock > div { display:grid; grid-template-columns:repeat(4,1fr); gap:9px; }
      .journal-section-mock .visual-slot { min-height:115px; padding:12px; background:#ebe4d9; color:#211e1a; font:10px/1.2 Georgia,serif; }
      .chosen-slot { margin:12px 0 18px; padding:14px; background:#f0eee9; border-left:4px solid #aaa; }
      .chosen-slot small,.chosen-slot strong { display:block; }
      .chosen-slot small { color:var(--muted); font-size:9px; letter-spacing:.12em; }
      .slot-legend { display:flex; flex-wrap:wrap; gap:10px; margin-top:20px; color:var(--muted); font-size:10px; }
      .slot-legend span { display:flex; align-items:center; gap:5px; }
      .slot-legend i { width:9px; height:9px; border-radius:50%; background:#ccc; }
      .slot-legend i.manual { background:var(--cm-red); }
      .slot-legend i.automatic { background:#2c6f9e; }
      .bulk-publication-panel { border-top:5px solid var(--cm-red); }
      .bulk-options { display:grid; grid-template-columns:auto minmax(150px,.7fr) minmax(220px,1.2fr) minmax(180px,.8fr) auto; gap:10px; align-items:center; margin-bottom:14px; }
      .bulk-options label,.bulk-options input,.bulk-options select { margin:0; }
      .bulk-options input[type=checkbox] { width:auto; }
      .publication-article-list { border:1px solid var(--line); }
      .publication-article-list article { display:grid; grid-template-columns:35px 35px 1fr auto; gap:8px; align-items:center; padding:13px; border-bottom:1px solid var(--line); }
      .publication-article-list article:last-child { border-bottom:0; }
      .publication-article-list label,.publication-article-list input { width:auto; margin:0; }
      .publication-article-list strong,.publication-article-list small { display:block; }
      .publication-article-list small { margin-top:3px; color:var(--muted); }

      @media (max-width:980px) {
        .publication-console-grid { grid-template-columns:1fr; }
        .manual-placement-panel { position:static; }
        .bulk-options { grid-template-columns:1fr 1fr; }
        .bulk-options input[type=submit] { width:100%; }
      }
      @media (max-width:760px) {
        .header-inner { width:min(100% - 24px,1240px); }
        .masthead .header-inner { min-height:74px; }
        .brand-mark { width:54px; height:46px; font-size:25px; }
        .brand-name { font-size:21px; }
        .session span { display:none; }
        .main-nav { overflow:hidden; }
        .main-nav .header-inner { width:100%; padding:0 8px; overflow-x:auto; scrollbar-width:none; }
        .main-nav .header-inner::-webkit-scrollbar { display:none; }
        .nav-link { padding:0 12px; }
        main { margin-top:24px; padding:0 14px; }
        h1 { font-size:34px; }
        .page-heading,.callout { flex-direction:column; }
        .page-heading > .button, .callout > .button { width:100%; text-align:center; }
        .card { padding:17px; }
        .grid { grid-template-columns:1fr 1fr; gap:10px; }
        .stat { padding:15px; }
        .stat strong { font-size:32px; }
        .stat span { font-size:11px; }
        .search-bar { flex-direction:column; }\n        .bulk-toolbar { align-items:stretch; flex-direction:column; }\n        .bulk-toolbar button { width:100%; }
        .search-bar input[type=submit] { width:100%; }
        table, thead, tbody, tr, th, td { display:block; }
        table { background:transparent; box-shadow:none; border-top:0; }
        thead { display:none; }
        tbody { display:grid; gap:12px; }
        tr { padding:8px 14px; background:#fff; border-top:3px solid var(--cm-red); box-shadow:0 4px 14px rgba(0,0,0,.05); }
        td { display:grid; grid-template-columns:minmax(92px,35%) 1fr; gap:10px; padding:9px 0; border-bottom:1px solid #eee; overflow-wrap:anywhere; }
        td:last-child { border-bottom:0; }
        td::before { content:attr(data-label); color:#666; font-size:10px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; }
        td.actions { align-items:start; }
        .actions { align-items:flex-start; }
        .result-row { align-items:flex-start; }
        .loading-indicator { left:14px; right:14px; bottom:14px; max-width:none; }
        .dashboard-columns { grid-template-columns:1fr; gap:30px; }
        .populate-form,.bulk-options { grid-template-columns:1fr; }
        .populate-form input[type=submit] { width:100%; }
        .cinemagazine-mock > header nav { float:none; display:block; margin-top:8px; }
        .cinema-news-mock > div { grid-template-columns:1fr 1fr; }
        .journal-front-mock { grid-template-columns:1fr; }
        .journal-front-mock aside { border-left:0; border-top:1px solid #aaa294; padding:10px 0 0; }
        .journal-section-mock > div { grid-template-columns:1fr 1fr; }
        .publication-article-list article { grid-template-columns:28px 28px 1fr; }
        .publication-article-list article > .badge { grid-column:3; justify-self:start; }
        .distribution-fields { grid-template-columns:1fr; margin-left:0; }
        .publication-state { margin-left:0; }\n        .image-rights-grid { grid-template-columns:1fr; }\n        .image-rights-grid .wide { grid-column:auto; }\n        .licensed-image-preview { grid-template-columns:90px 1fr; }\n        .licensed-image-preview img { width:90px; height:75px; }\n        .gastronomy-publish-form { grid-template-columns:1fr; }
        .editor-workspace { grid-template-columns:1fr; }
        .publication-customizer { position:static; }
        .mock-cover-body { grid-template-columns:1fr; }
        .mock-category-leads { grid-template-columns:1fr; }
        .mock-category-list { grid-template-columns:1fr 1fr; }
        .mock-breaking { grid-template-columns:auto 1fr; }
        .mock-breaking button:nth-of-type(n+2) { display:none; }
        .mock-fresh-grid { grid-template-columns:1fr 1fr; }
        .mock-hero { min-height:185px; }\n        .gastronomy-publish-form input[type=submit] { width:100%; }\n        .publication-preview { grid-template-columns:90px 1fr; }\n        .publication-preview img { width:90px; height:75px; }\n        .unpublish-row { align-items:flex-start; flex-direction:column; }
        .activity-filter > div { flex-direction:column; }
        .activity-filter input { width:100%; }
      }
      @media (max-width:420px) { .grid { grid-template-columns:1fr; } .brand-product { letter-spacing:.1em; } .session .logout { padding:7px 9px !important; } }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="masthead"><div class="header-inner">
        <%= link_to root_path, class: "brand" do %>
          <span class="brand-mark">CM</span>
          <span><span class="brand-name">Correio da Manhã</span><span class="brand-product">Rede de Conteúdo</span></span>
        <% end %>
        <% if user_signed_in? %><div class="session"><span class="presence"><span class="presence-dot online"></span><%= current_user.name.presence || current_user.email %></span><%= button_to "Sair", destroy_user_session_path, method: :delete, class: "logout" %></div><% end %>
      </div></div>
      <% if user_signed_in? %><nav class="main-nav"><div class="header-inner">
        <%= link_to "Painel", root_path, class: nav_link_class(root_path) %>
        <%= link_to "Monitoramento", topics_path, class: nav_link_class(topics_path) %>
        <%= link_to "Acervo", articles_path, class: nav_link_class(articles_path) %>
        <% navigation_sites.each do |site| %>
          <%= link_to site.name, publication_path(site.publication_key), class: "nav-link #{'active' if params[:publication_key] == site.publication_key}" %>
        <% end %>
        <% if current_user.admin? %>
          <%= link_to "Canais RSS", feeds_path, class: nav_link_class(feeds_path) %>
          <%= link_to "Sites", sites_path, class: nav_link_class(sites_path) %>
          <%= link_to "Categorias", categories_path, class: nav_link_class(categories_path) %>
          <%= link_to "Usuários", users_path, class: nav_link_class(users_path) %>
          <%= link_to "Atividades", activity_logs_path, class: nav_link_class(activity_logs_path) %>
        <% end %>
      </div></nav><% end %>
    </header>
    <main>
      <% if notice.present? %><div class="notice"><%= notice %></div><% end %>
      <% if alert.present? %><div class="alert"><%= alert %></div><% end %>
      <%= yield %>
    </main>
    <div class="loading-indicator" id="loading-indicator" role="status" aria-live="polite" aria-hidden="true">
      <span class="loading-spinner"></span>
      <span class="loading-copy"><strong id="loading-title">Processando solicitação</strong><span>Isso pode levar alguns segundos.</span></span>
    </div>
    <script>
      (() => {
        const indicator = () => document.getElementById("loading-indicator");
        const title = () => document.getElementById("loading-title");

        document.addEventListener("turbo:submit-start", (event) => {
          const form = event.target;
          if (form.dataset.loadingStarted === "true") return;
          form.dataset.loadingStarted = "true";
          const button = form.querySelector("button[type='submit'], input[type='submit']");
          const label = button?.dataset.loadingLabel || form.dataset.loadingLabel || "Processando solicitação";
          if (button) {
            button.dataset.originalLabel = button.tagName === "INPUT" ? button.value : button.textContent;
            if (button.tagName === "INPUT") button.value = label;
            else button.textContent = label;
            button.classList.add("is-loading");
            button.disabled = true;
          }
          title().textContent = label;
          indicator().classList.add("visible");
          indicator().setAttribute("aria-hidden", "false");
        });

        document.addEventListener("submit", (event) => {
          const form = event.target;
          if (form.dataset.loadingStarted === "true") return;
          form.dataset.loadingStarted = "true";
          const button = form.querySelector("button[type='submit'], input[type='submit']");
          const label = button?.dataset.loadingLabel || form.dataset.loadingLabel || "Processando solicitação";
          if (button) {
            button.dataset.originalLabel = button.tagName === "INPUT" ? button.value : button.textContent;
            if (button.tagName === "INPUT") button.value = label;
            else button.textContent = label;
            button.classList.add("is-loading");
            button.disabled = true;
          }
          title().textContent = label;
          indicator().classList.add("visible");
          indicator().setAttribute("aria-hidden", "false");
        });

        document.addEventListener("turbo:submit-end", (event) => {
          const button = event.target.querySelector("button[type='submit'], input[type='submit']");
          if (button?.dataset.originalLabel) {
            if (button.tagName === "INPUT") button.value = button.dataset.originalLabel;
            else button.textContent = button.dataset.originalLabel;
          }
          if (button) { button.classList.remove("is-loading"); button.disabled = false; }
          delete event.target.dataset.loadingStarted;
          indicator().classList.remove("visible");
          indicator().setAttribute("aria-hidden", "true");
        });

        document.addEventListener("turbo:before-cache", () => indicator()?.classList.remove("visible"));

        const sendPresence = () => {
          if (document.visibilityState !== "visible") return;
          const token = document.querySelector("meta[name='csrf-token']")?.content;
          if (!token) return;
          fetch("<%= presence_path %>", {
            method: "POST",
            credentials: "same-origin",
            headers: { "X-CSRF-Token": token, "Accept": "application/json" }
          }).catch(() => {});
        };
        <% if user_signed_in? %>
          setInterval(sendPresence, 60_000);
          document.addEventListener("visibilitychange", sendPresence);
        <% end %>
      })();
    </script>
  </body>
</html>
