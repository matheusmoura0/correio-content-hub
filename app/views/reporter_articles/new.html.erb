<div class="page-heading">
  <div><p class="eyebrow">Turismo Hoje · pauta própria</p><h1>Escrever matéria</h1><p class="muted">O rascunho fica no Hub para revisão antes da publicação.</p></div>
  <%= link_to "Voltar às matérias", articles_path(site_domain: @site.domain), class: "button secondary" %>
</div>
<% if @article.errors.any? %><div class="alert"><%= @article.errors.full_messages.to_sentence %></div><% end %>
<section class="card">
  <%= form_with model: @article, url: @article.persisted? ? reporter_article_path(@article) : reporter_articles_path, class: "reporter-article-form" do |form| %>
    <%= form.label :title, "Título" %><%= form.text_field :title, required: true, maxlength: 180, placeholder: "Escreva um título claro e informativo" %>
    <%= form.label :description, "Linha fina" %><%= form.text_area :description, rows: 3, maxlength: 320, placeholder: "Resuma a notícia em uma ou duas frases" %>
    <%= form.label :content, "Texto da matéria" %><%= form.text_area :content, rows: 22, required: true, placeholder: "Escreva o texto da reportagem…" %>
    <%= label_tag :category_id, "Editoria" %>
    <%= select_tag :category_id, options_from_collection_for_select(@site.categories.order(:name), :id, :name, @article.site_articles.find_by(site: @site)&.category_id), include_blank: "Escolha uma editoria" %>
    <p class="muted">Repórter: <strong><%= @article.author.presence || current_user.name.presence || current_user.email %></strong>. Imagens podem ser adicionadas pela edição após a confirmação dos direitos de uso.</p>
    <%= form.submit @article.persisted? ? "Salvar rascunho" : "Enviar para revisão", class: "accent" %>
  <% end %>
</section>
