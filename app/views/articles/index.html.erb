<div style="display:flex;justify-content:space-between;align-items:center">
  <h1>Matérias</h1>
  <div>
    <%= link_to "Todas", articles_path %> ·
    <%= link_to "Importadas", articles_path(status: "imported") %> ·
    <%= link_to "Aprovadas", articles_path(status: "approved") %> ·
    <%= link_to "Publicadas", articles_path(status: "published") %>
  </div>
</div>
<table>
  <thead><tr><th>Título</th><th>Fonte</th><th>Data</th><th>Status</th></tr></thead>
  <tbody>
    <% @articles.each do |article| %>
      <tr>
        <td><%= link_to article.title, article_path(article) %></td>
        <td><%= article.feed.name %></td>
        <td><%= article.published_at&.strftime("%d/%m/%Y %H:%M") || "—" %></td>
        <td><%= article.status %></td>
      </tr>
    <% end %>
  </tbody>
</table>
