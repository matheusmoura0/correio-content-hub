<div class="page-heading"><div><p class="eyebrow">Matéria original</p><h1><%= @article.title %></h1></div><span class="<%= article_status_class(@article.status) %>"><%= article_status_label(@article.status) %></span></div>
<p class="muted"><%= @article.feed.name %> · <%= @article.published_at&.strftime("%d/%m/%Y %H:%M") %></p>

<div class="card">
  <p><strong>Origem:</strong> <%= link_to @article.source_url, @article.source_url, target: "_blank", rel: "noopener" %></p>
  <% if (@article.original_image_url.presence || @article.image_url).present? %><div class="source-image-reference"><%= image_tag(@article.image_url.presence || @article.original_image_url, alt: "") %><span><%= @article.feed.correio_source? ? "Imagem original do Correio — autorizada para uso e opcional na publicação" : "Imagem coletada da fonte — apenas referência, sem autorização automática de publicação" %></span></div><% end %>
  <div class="article-copy"><%= simple_format(@article.content.presence || @article.description) %></div>
</div>

<% if @article.feed.correio_source? %>
<section class="card image-rights-panel">
  <div class="page-heading compact">
    <div><p class="eyebrow">Imagem da matéria</p><h2>Imagem opcional</h2></div>
    <span class="badge status-approved">Conteúdo próprio</span>
  </div>
  <% if @article.image_url.present? %>
    <div class="licensed-image-preview"><%= image_tag @article.image_url, alt: "" %><span>Correio da Manhã · imagem obtida automaticamente da matéria original.</span></div>
  <% else %>
    <p class="muted">A página original não forneceu uma imagem. Isso não impede a publicação: o site deverá usar o layout sem imagem.</p>
  <% end %>
</section>
<% else %>
<section class="card image-rights-panel">
  <div class="page-heading compact">
    <div><p class="eyebrow">Direitos de imagem</p><h2>Imagem licenciada para publicação</h2></div>
    <% if @article.licensed_image_ready? %><span class="badge status-approved">Direitos confirmados</span><% else %><span class="badge status-reviewing">Revisão necessária</span><% end %>
  </div>
  <p class="muted">Não use automaticamente a imagem coletada da fonte. Escolha uma imagem própria, autorizada ou de um banco com licença compatível.</p>
  <div class="licensed-image-sources">
    <%= link_to "Buscar no Pexels ↗", "https://www.pexels.com/search/#{@article.title.parameterize}/", target: "_blank", rel: "noopener", class: "button secondary" %>
    <%= link_to "Buscar no Unsplash ↗", "https://unsplash.com/s/photos/#{@article.title.parameterize}", target: "_blank", rel: "noopener", class: "button secondary" %>
  </div>

  <% if @article.errors.any? %><div class="alert"><%= @article.errors.full_messages.to_sentence %></div><% end %>

  <%= form_with model: @article, class: "image-rights-form" do |form| %>
    <%= hidden_field_tag :image_rights_review, "1" %>
    <div class="image-rights-grid">
      <div class="wide"><%= form.label :image_url, "URL direta da imagem licenciada" %><%= form.url_field :image_url, placeholder: "https://..." %></div>
      <div class="wide"><%= form.label :image_source_url, "Página de origem da imagem" %><%= form.url_field :image_source_url, placeholder: "Página do Pexels, Unsplash ou autorização" %></div>
      <div><%= form.label :image_author, "Fotógrafo ou autor" %><%= form.text_field :image_author, placeholder: "Nome do autor" %></div>
      <div><%= form.label :image_license, "Licença" %><%= form.select :image_license, [["Selecione", ""]] + Article::IMAGE_LICENSES.map { |value, label| [label, value] } %></div>
      <div class="wide"><%= form.label :image_license_url, "Link da licença ou autorização" %><%= form.url_field :image_license_url, placeholder: "Opcional para imagem própria; recomendado nos demais casos" %></div>
    </div>
    <% if @article.image_url.present? %><div class="licensed-image-preview"><%= image_tag @article.image_url, alt: "" %><span><%= @article.image_credit.presence || "Crédito ainda não informado" %></span></div><% end %>
    <label class="rights-confirmation">
      <%= check_box_tag :image_rights_confirmed, "1", @article.image_rights_confirmed_at.present? %>
      <span>Confirmo que a imagem possui autorização ou licença compatível com publicação editorial e comercial.</span>
    </label>
    <% if @article.image_rights_confirmed_at.present? %><p class="rights-audit">Confirmado por <%= @article.image_rights_confirmed_by&.name.presence || @article.image_rights_confirmed_by&.email %> em <%= @article.image_rights_confirmed_at.strftime("%d/%m/%Y às %H:%M") %>.</p><% end %>
    <%= form.submit "Salvar direitos da imagem", class: "accent", data: { loading_label: "Validando imagem…" } %>
  <% end %>
</section>
<% end %>

<section class="card rewrite-panel">
  <p class="eyebrow">Assistente editorial</p>
  <h2>Reescrever com IA</h2>
  <p class="muted">A IA usa somente o texto-fonte acima. O resultado precisa ser revisado antes de qualquer publicação.</p>
  <%= form_with url: rewrite_article_path(@article), method: :post do |form| %>
    <%= form.label :rewrite_instructions, "Orientações opcionais" %>
    <%= form.text_area :rewrite_instructions, value: @article.rewrite_instructions, rows: 3, placeholder: "Ex.: texto de 500 palavras, tom econômico e intertítulos curtos" %>
    <%= form.submit @article.rewritten_at.present? ? "Gerar nova versão" : "Reescrever matéria", class: "accent", data: { loading_label: "Reescrevendo matéria…" } %>
  <% end %>
</section>

<% if @article.rewritten_at.present? %>
  <section class="card rewritten">
    <div class="page-heading compact"><div><p class="eyebrow">Versão gerada por IA</p><h2><%= @article.rewritten_title %></h2></div><span class="muted"><%= @article.rewritten_at.strftime("%d/%m/%Y %H:%M") %></span></div>
    <%= form_with model: @article do |form| %>
      <%= form.label :rewritten_title, "Título revisado" %><%= form.text_field :rewritten_title %>
      <%= form.label :rewritten_content, "Texto revisado" %><%= form.text_area :rewritten_content, rows: 18 %>
      <%= form.hidden_field :status, value: @article.status %>
      <%= form.submit "Salvar alterações" %>
    <% end %>
  </section>
<% end %>

<section class="card publication-panel">
  <div class="page-heading compact">
    <div><p class="eyebrow">Revista de Gastronomia</p><h2>Publicação direta</h2></div>
    <% if @gastronomy_distribution&.status == "published" %><span class="badge status-published">No ar</span><% else %><span class="badge">Fora do ar</span><% end %>
  </div>

  <% if @gastronomy_site.nil? %>
    <div class="alert">O site Revista de Gastronomia ainda não está configurado no Content Hub.</div>
  <% elsif !@article.publication_ready? %>
    <div class="publication-requirement">
      <strong>Matéria ainda não pronta</strong>
      <p>Para fontes externas, confirme os direitos da imagem antes de publicar.</p>
    </div>
  <% else %>
    <div class="publication-preview <%= "without-image" if @article.image_url.blank? %>">
      <%= image_tag @article.image_url, alt: "" if @article.image_url.present? %>
      <div><span><%= @gastronomy_distribution&.category&.name || "Sem editoria" %></span><strong><%= @article.rewritten_title.presence || @article.title %></strong><small><%= @article.image_url.present? ? @article.image_credit : "Publicação sem imagem" %></small></div>
    </div>

    <%= form_with url: publish_to_gastronomy_article_path(@article), method: :patch, scope: :publication, class: "gastronomy-publish-form" do |form| %>
      <div>
        <%= form.label :placement, "Posição na revista" %>
        <%= form.select :placement, [["Novidades", "latest"], ["Manchete principal", "hero"], ["Escolha do editor", "editor_pick"]], selected: @gastronomy_distribution&.placement || "latest" %>
      </div>
      <div>
        <%= form.label :category_id, "Editoria" %>
        <%= form.select :category_id, [["Sem editoria", ""]] + @gastronomy_site.categories.order(:name).map { |category| [category.name, category.id] }, selected: @gastronomy_distribution&.category_id %>
      </div>
      <div>
        <%= form.label :position, "Ordem" %>
        <%= form.number_field :position, value: @gastronomy_distribution&.position || 0, min: 0, max: 999 %>
      </div>
      <%= form.submit @gastronomy_distribution&.status == "published" ? "Atualizar publicação" : "Publicar na revista", class: "accent", data: { loading_label: "Publicando na revista…" } %>
    <% end %>

    <% if @gastronomy_distribution&.status == "published" %>
      <div class="unpublish-row">
        <span>Publicada em <%= @gastronomy_distribution.published_at&.strftime("%d/%m/%Y às %H:%M") %></span>
        <%= button_to "Retirar do ar", unpublish_from_gastronomy_article_path(@article), method: :patch, class: "secondary", data: { loading_label: "Retirando do ar…" } %>
      </div>
    <% end %>
  <% end %>
</section>
