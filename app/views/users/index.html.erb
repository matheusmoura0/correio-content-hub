<div class="page-heading"><div><h1>Usuários do beta</h1><p class="muted"><%= @users.size %> de <%= User::MAX_BETA_USERS %> contas utilizadas</p></div><%= link_to "Novo usuário", new_user_path, class: "button" if @users.size < User::MAX_BETA_USERS %></div>
<div class="card"><table><thead><tr><th>Usuário</th><th>Perfil</th><th>Presença</th><th>Última atividade</th><th>Ações</th></tr></thead><tbody>
<% @users.each do |user| %><% last_activity = user.activity_logs.max_by(&:created_at) %><tr><td data-label="Usuário"><strong><%= user.name.presence || "—" %></strong><small><%= user.email %></small></td><td data-label="Perfil"><span class="badge"><%= user.admin? ? "Administrador" : "Usuário" %></span></td><td data-label="Presença"><span class="presence"><span class="presence-dot <%= user.online? ? 'online' : 'offline' %>"></span><%= user.online? ? "Online" : "Offline" %></span><small><%= user.last_seen_at.present? ? "Visto #{time_ago_in_words(user.last_seen_at)} atrás" : "Ainda não acessou" %></small></td><td data-label="Última atividade"><%= last_activity&.description || "Nenhuma atividade" %><% if last_activity %><small><%= l(last_activity.created_at, format: :short) %></small><% end %></td><td data-label="Ações" class="actions"><%= link_to "Editar", edit_user_path(user) %><% unless user == current_user %><%= button_to "Excluir", user_path(user), method: :delete, class: "link-danger", form: { data: { turbo_confirm: "Excluir este usuário?" } } %><% end %></td></tr><% end %>
</tbody></table></div>
