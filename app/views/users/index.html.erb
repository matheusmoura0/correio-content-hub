<div class="page-heading"><div><h1>Usuários do beta</h1><p class="muted"><%= @users.size %> de <%= User::MAX_BETA_USERS %> contas utilizadas</p></div><%= link_to "Novo usuário", new_user_path, class: "button" if @users.size < User::MAX_BETA_USERS %></div>
<div class="card"><table><thead><tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th></th></tr></thead><tbody>
<% @users.each do |user| %><tr><td data-label="Nome"><%= user.name.presence || "—" %></td><td data-label="E-mail"><%= user.email %></td><td data-label="Perfil"><span class="badge"><%= user.admin? ? "Administrador" : "Usuário" %></span></td><td data-label="Ações" class="actions"><%= link_to "Editar", edit_user_path(user) %><% unless user == current_user %><%= button_to "Excluir", user_path(user), method: :delete, class: "link-danger", form: { data: { turbo_confirm: "Excluir este usuário?" } } %><% end %></td></tr><% end %>
</tbody></table></div>
