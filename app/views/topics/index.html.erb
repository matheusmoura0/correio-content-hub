<div class="page-heading">
  <div><p class="eyebrow">Monitoramento editorial</p><h1>Monitoramento de pautas</h1><p class="muted">Acompanhe assuntos nos canais RSS e reúna matérias do Correio para revisão e distribuição.</p></div>
  <%= link_to "Novo monitoramento", new_topic_path, class: "button" %>
</div>

<% if @topics.empty? %>
  <div class="empty-state"><h2>Nenhum monitoramento criado</h2><p>Crie um monitoramento com os assuntos ou palavras-chave que deseja acompanhar nos canais cadastrados.</p></div>
<% end %>

<% @topics.each do |topic| %>
  <section class="card topic" id="topic-<%= topic.id %>">
    <div class="page-heading compact">
      <div>
        <h2><%= topic.name %></h2>
        <p class="muted"><%= topic.keyword_list.join(" · ") %> · <%= { "web" => "web", "rss" => "RSS", "both" => "web + RSS" }.fetch(topic.search_mode, topic.search_mode) %> · <%= topic.match_mode == "all" ? "todos os termos" : "qualquer termo" %></p>
      </div>
      <div class="actions">
        <%= button_to "Atualizar resultados", run_topic_path(topic), method: :post, class: "button accent", data: { loading_label: "Atualizando monitoramento…" } %>
        <%= link_to "Editar", edit_topic_path(topic), class: "button secondary" %>
        <%= button_to "Excluir", topic_path(topic), method: :delete, class: "button danger", form: { data: { turbo_confirm: "Excluir este monitoramento?" } } %>
      </div>
    </div>
    <p class="metric"><strong><%= topic.topic_articles.size %></strong> matéria(s) encontrada(s) <span class="muted">· última atualização: <%= topic.last_run_at&.strftime("%d/%m/%Y %H:%M") || "ainda não executada" %></span></p>
    <% topic.topic_articles.sort_by(&:created_at).reverse.first(5).each do |match| %>
      <div class="result-row">
        <div><%= link_to match.article.title, article_path(match.article) %><small><%= match.article.feed.name %> · termos: <%= match.matched_terms %></small></div>
        <span class="<%= article_status_class(match.article.status) %>"><%= article_status_label(match.article.status) %></span>
      </div>
    <% end %>
    <% if topic.topic_articles.size > 5 %><%= link_to "Ver todas as matérias", articles_path(topic_id: topic.id) %><% end %>
  </section>
<% end %>
