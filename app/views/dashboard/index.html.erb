<h1>Dashboard</h1>
<div class="grid">
  <div class="card"><strong><%= @sites_count %></strong><br><span class="muted">sites</span></div>
  <div class="card"><strong><%= @feeds_count %></strong><br><span class="muted">feeds</span></div>
  <div class="card"><strong><%= @articles_count %></strong><br><span class="muted">matérias</span></div>
  <div class="card"><strong><%= @pending_count %></strong><br><span class="muted">aguardando revisão</span></div>
</div>

<h2>Últimas importações</h2>
<% @recent_articles.each do |article| %>
  <div class="card">
    <strong><%= link_to article.title, article_path(article) %></strong>
    <div class="muted"><%= article.feed.name %> · <%= article.status %></div>
  </div>
<% end %>
