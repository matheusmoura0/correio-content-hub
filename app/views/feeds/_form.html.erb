<%= form_with model: feed do |form| %>
  <% feed.errors.full_messages.each do |message| %><p class="alert"><%= message %></p><% end %>
  <%= form.label :name, "Nome do canal" %>
  <%= form.text_field :name, placeholder: "Ex.: Correio da Manhã — Economia", required: true %>
  <%= form.label :url, "URL do feed RSS" %>
  <%= form.url_field :url, placeholder: "https://www.correiodamanha.com.br/rss/...", required: true %>
  <p class="muted">Feeds dos domínios do Correio são identificados como fontes oficiais e exportados com crédito e URL canônica.</p>
  <%= form.label :site_id, "Destino padrão" %>
  <%= form.collection_select :site_id, Site.order(:name), :id, :name, include_blank: "Somente acervo — distribuir depois" %>
  <%= form.label :category_id, "Categoria padrão no destino" %>
  <%= form.collection_select :category_id, Category.includes(:site).order(:name), :id, :name, include_blank: "Definir durante a publicação" %>
  <label class="check"><%= form.check_box :active %> Canal ativo e disponível para monitoramento</label>
  <%= form.submit feed.persisted? ? "Salvar canal RSS" : "Adicionar canal RSS" %>
<% end %>
