<%= form_with model: feed do |form| %>
  <% feed.errors.full_messages.each do |message| %><p class="alert"><%= message %></p><% end %>
  <%= form.label :name, "Nome do canal" %>
  <%= form.text_field :name, placeholder: "Ex.: Correio da Manhã — Economia", required: true %>
  <%= form.label :url, "URL do feed RSS" %>
  <%= form.url_field :url, placeholder: "https://www.correiodamanha.com.br/politica/sitemap-rss.xml", required: true %>
  <p class="muted">Feeds oficiais do Correio usam automaticamente as imagens próprias, preservam o crédito e o link canônico.</p>
  <%= form.label :site_id, "Publicar diretamente em" %>
  <%= form.collection_select :site_id, Site.where(active: true).order(:name), :id, :name, include_blank: "Somente acervo — não publicar automaticamente" %>
  <p class="muted">Ao escolher um destino, novas matérias do Correio que possuam imagem serão publicadas diretamente nesse site. Fontes externas permanecem como rascunho.</p>
  <%= form.label :category_id, "Categoria padrão no destino" %>
  <%= form.collection_select :category_id, Category.includes(:site).order(:name), :id, :name, include_blank: "Sem categoria padrão" %>
  <label class="check"><%= form.check_box :active %> Canal ativo e disponível para monitoramento</label>
  <%= form.submit feed.persisted? ? "Salvar canal RSS" : "Adicionar canal RSS" %>
<% end %>
