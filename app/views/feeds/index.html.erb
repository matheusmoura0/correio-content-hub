<div class="page-heading">
  <div><p class="eyebrow">Coleta editorial</p><h1>Fontes de notícias</h1></div>
  <div class="actions">
    <%= button_to "Sincronizar lista de editorias", sync_correio_rss_catalog_path, method: :post, class: "button secondary", data: { loading_label: "Sincronizando canais…" } %>
    <%= link_to "Adicionar canal RSS", new_feed_path, class: "button" %>
  </div>
</div>

<div class="grid publication-stats">
  <div class="card stat"><strong><%= @feeds.count %></strong><span>Canais cadastrados</span></div>
  <div class="card stat"><strong><%= @feeds.count(&:active?) %></strong><span>Canais ativos</span></div>
  <div class="card stat"><strong><%= @feeds.count(&:correio_source?) %></strong><span>Fontes oficiais</span></div>
  <div class="card stat"><strong><%= @article_counts.values.sum %></strong><span>Matérias importadas</span></div>
</div>

<table>
  <thead><tr><th>Canal</th><th>Origem</th><th>Destino</th><th>Última coleta</th><th></th></tr></thead>
  <tbody>
    <% @feeds.each do |feed| %>
      <tr>
        <td data-label="Canal"><strong><%= feed.name %></strong><small><%= feed.url %></small></td>
        <td data-label="Origem"><span class="badge <%= feed.correio_source? ? "status-approved" : "status-reviewing" %>"><%= feed.correio_source? ? "Correio da Manhã" : "Fonte externa" %></span><small><%= feed.active? ? "Coleta automática" : "Canal pausado" %></small></td>
        <td data-label="Destino"><%= feed.site&.publication_destination? ? feed.site.name : "Somente acervo" %><small>Aprovação antes de publicar<%= " · #{feed.category.name}" if feed.category && feed.category.site_id == feed.site_id %></small></td>
        <td data-label="Última busca"><%= feed.last_imported_at&.strftime("%d/%m/%Y %H:%M") || "Ainda não executada" %><% if feed.last_import_warning_count.positive? %><small class="suggestion-category-hint"><%= feed.last_import_warning_count %> aviso(s) na última coleta</small><% end %></td>
        <td data-label="Ações" class="actions">
          <%= button_to "Buscar matérias", import_feed_path(feed), method: :post, data: { loading_label: "Lendo todas as matérias do XML…" } %>
          <%= link_to "Configurar", edit_feed_path(feed), class: "button secondary" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
