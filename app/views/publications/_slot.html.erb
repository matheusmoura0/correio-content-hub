<div class="cover-slot">
  <div class="slot-label"><span><%= placement == "hero" ? "01" : "02" %></span><strong><%= title %></strong></div>
  <% if distribution %>
    <div class="cover-slot-image"><%= image_tag distribution.article.image_url, alt: "" %></div>
    <h3><%= distribution.article.rewritten_title.presence || distribution.article.title %></h3>
    <p class="muted"><%= distribution.category&.name || "Sem editoria" %> · <%= distribution.status == "published" ? "No ar" : "Rascunho" %></p>
    <div class="quick-publication-form">
      <%= button_to distribution.status == "published" ? "Retirar do ar" : "Publicar destaque",
        publication_path(distribution),
        method: :patch,
        params: { site_article: { status: distribution.status == "published" ? "draft" : "published", placement: placement } },
        class: distribution.status == "published" ? "secondary" : "accent",
        data: { loading_label: distribution.status == "published" ? "Retirando…" : "Publicando…" } %>
      <%= link_to "Editar matéria", article_path(distribution.article), class: "inline-link" %>
    </div>
  <% else %>
    <div class="slot-empty"><strong>Posição livre</strong><p>Na fila editorial, escolha esta posição para uma matéria.</p></div>
  <% end %>
</div>
